{
	"name": "carga-academica-movil",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"cap:sync": "npm run build && npx cap sync android",
		"cap:open": "npx cap open android",
		"cap:run": "npm run cap:sync && npx cap run android",
		"android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease",
		"android:apk:win": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
	},
	"devDependencies": {
		"@capacitor/assets": "^4.0.0",
		"@capacitor/cli": "^8.6.0",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.6.0",
		"@capacitor/file-viewer": "^2.0.4",
		"@capacitor/filesystem": "^8.1.5",
		"@capacitor/keyboard": "^8.0.6",
		"@capacitor/share": "^8.0.3",
		"@capacitor/splash-screen": "^8.0.2",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.2",
		"datatables.net-bs5": "^2.3.4",
		"jquery": "^3.7.1",
		"sweetalert2": "^11.26.25"
	},
	"description": "Carga Académica – versión web y móvil (Android) con SvelteKit + Capacitor"
}
